# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environments
.venv/
env/
venv/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/

# IDEs
.vscode/
.idea/
.DS_Store

# Testing / Coverage
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage-*

# Project-Specific (Data & Logs)
data/
logs/
*.log
examples/data/

# Reports (regenerated by CI)
*-checkstyle.xml
*-diff.txt
flake8.txt
mypy.txt
coverage.xml
coverage-sources.zip
test-report.xml

# Pretrained model caches (downloaded by deepinv at first use)
*.pt
*.pth
*.ckpt

# Everything a sweep (`matrainer sweep`) writes: per-run logs, the file-backed trackers, the
# SavedModel export and the huggingface Trainer's output_dir all land under one tree on purpose.
sweep_logs/
# The run manifest's own tree. `RunManifest` falls back to `runs/<experiment>/<run>` when nothing
# sets `run_dir` (matrainer's `tracking/manifest.py`), which is independent of a tracker's
# `save_dir` — so a sweep writes here as well as under `sweep_logs/`.
runs/
.cache/
/pyrightconfig.json
